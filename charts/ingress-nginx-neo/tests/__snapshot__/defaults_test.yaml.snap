            app.kubernetes.io/instance: ingress-nginx-neo
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: ingress-nginx-neo
            app.kubernetes.io/part-of: ingress-nginx-neo
            app.kubernetes.io/version: v1.2.3
            helm.sh/chart: ingress-nginx-neo-1.2.3
          name: ingress-nginx-neo-admission-patch
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - patch
                - --webhook-name=ingress-nginx-neo-admission
                - --namespace=$(POD_NAMESPACE)
                - --patch-mutating=false
                - --secret-name=ingress-nginx-neo-admission
                - --patch-failure-policy=Fail
              env:
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: ghcr.io/kuzmenko-pavel/ingress-nginx-neo/kube-webhook-certgen:v1.2.3
              imagePullPolicy: IfNotPresent
              name: patch
              securityContext:
                allowPrivilegeEscalation: false
