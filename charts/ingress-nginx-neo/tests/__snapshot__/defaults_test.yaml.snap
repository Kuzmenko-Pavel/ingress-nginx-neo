  3: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
        helm.sh/hook: pre-install,pre-upgrade
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
      labels:
        app.kubernetes.io/component: admission-webhook
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: ingress-nginx-neo
        app.kubernetes.io/part-of: ingress-nginx-neo
        app.kubernetes.io/version: v1.2.3
        helm.sh/chart: ingress-nginx-neo-1.2.3
      name: ingress-nginx-neo-admission-create
      namespace: ingress-nginx-neo
    spec:
      template:
        metadata:
          labels:
            app.kubernetes.io/component: admission-webhook
            app.kubernetes.io/instance: ingress-nginx-neo
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: ingress-nginx-neo
            app.kubernetes.io/part-of: ingress-nginx-neo
            app.kubernetes.io/version: v1.2.3
            helm.sh/chart: ingress-nginx-neo-1.2.3
          name: ingress-nginx-neo-admission-create
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - create
                - --host=ingress-nginx-neo-controller-admission,ingress-nginx-neo-controller-admission.$(POD_NAMESPACE).svc
                - --namespace=$(POD_NAMESPACE)
                - --secret-name=ingress-nginx-neo-admission
              env:
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: ghcr.io/kuzmenko-pavel/ingress-nginx-neo/kube-webhook-certgen:v1.2.3
              imagePullPolicy: IfNotPresent
              name: create
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsGroup: 65532
                runAsNonRoot: true
                runAsUser: 65532
                seccompProfile:
                  type: RuntimeDefault
          nodeSelector:
            kubernetes.io/os: linux
          restartPolicy: OnFailure
          serviceAccountName: ingress-nginx-neo-admission
      ttlSecondsAfterFinished: 0
  4: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      annotations:
