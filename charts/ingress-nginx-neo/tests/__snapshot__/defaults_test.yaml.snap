      name: ingress-nginx-neo-admission
    rules:
      - apiGroups:
          - admissionregistration.k8s.io
        resourceNames:
          - ingress-nginx-neo-admission
        resources:
          - validatingwebhookconfigurations
        verbs:
          - get
          - update
  2: |
