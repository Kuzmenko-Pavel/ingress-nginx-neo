                readOnlyRootFilesystem: true
                runAsGroup: 65532
                runAsNonRoot: true
                runAsUser: 65532
                seccompProfile:
                  type: RuntimeDefault
          nodeSelector:
            kubernetes.io/os: linux
          restartPolicy: OnFailure
          serviceAccountName: ingress-nginx-neo-admission
      ttlSecondsAfterFinished: 0
