          - v1
        clientConfig:
          service:
            name: ingress-nginx-neo-controller-admission
            namespace: ingress-nginx-neo
            path: /networking/v1/ingresses
            port: 443
        failurePolicy: Fail
        matchPolicy: Equivalent
        name: validate.nginx.ingress.kubernetes.io
        rules:
