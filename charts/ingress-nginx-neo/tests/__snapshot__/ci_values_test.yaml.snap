controller-daemonset-metrics-values.yaml runs a DaemonSet with metrics:
  1: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: ingress-nginx-neo
        app.kubernetes.io/part-of: ingress-nginx-neo
        app.kubernetes.io/version: v1.2.3
        helm.sh/chart: ingress-nginx-neo-1.2.3
      name: ingress-nginx-neo-controller
      namespace: ingress-nginx-neo
    spec:
      minReadySeconds: 0
      revisionHistoryLimit: 10
      selector:
        matchLabels:
          app.kubernetes.io/component: controller
          app.kubernetes.io/instance: ingress-nginx-neo
          app.kubernetes.io/name: ingress-nginx-neo
      template:
        metadata:
          labels:
            app.kubernetes.io/component: controller
            app.kubernetes.io/instance: ingress-nginx-neo
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: ingress-nginx-neo
            app.kubernetes.io/part-of: ingress-nginx-neo
            app.kubernetes.io/version: v1.2.3
            helm.sh/chart: ingress-nginx-neo-1.2.3
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - /nginx-ingress-controller
                - --publish-service=$(POD_NAMESPACE)/ingress-nginx-neo-controller
                - --election-id=ingress-nginx-neo-leader
                - --controller-class=k8s.io/ingress-nginx
                - --ingress-class=nginx
                - --configmap=$(POD_NAMESPACE)/ingress-nginx-neo-controller
                - --validating-webhook=:8443
                - --validating-webhook-certificate=/usr/local/certificates/cert
                - --validating-webhook-key=/usr/local/certificates/key
                - --enable-metrics=true
              env:
                - name: POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: LD_PRELOAD
                  value: /usr/local/lib/libmimalloc.so
              image: ghcr.io/kuzmenko-pavel/ingress-nginx-neo/controller:v1.2.3
              imagePullPolicy: IfNotPresent
              lifecycle:
                preStop:
                  exec:
                    command:
                      - /wait-shutdown
              livenessProbe:
                failureThreshold: 5
                httpGet:
                  path: /healthz
                  port: 10254
                  scheme: HTTP
                initialDelaySeconds: 10
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 1
              name: controller
              ports:
                - containerPort: 80
                  name: http
                  protocol: TCP
                - containerPort: 443
                  name: https
                  protocol: TCP
                - containerPort: 10254
                  name: metrics
                  protocol: TCP
                - containerPort: 8443
                  name: webhook
                  protocol: TCP
              readinessProbe:
                failureThreshold: 3
                httpGet:
                  path: /healthz
                  port: 10254
                  scheme: HTTP
                initialDelaySeconds: 10
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 1
              resources:
                requests:
                  cpu: 100m
                  memory: 90Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  add:
                    - NET_BIND_SERVICE
                  drop:
                    - ALL
                readOnlyRootFilesystem: false
                runAsGroup: 82
                runAsNonRoot: true
                runAsUser: 101
                seccompProfile:
                  type: RuntimeDefault
              volumeMounts:
                - mountPath: /usr/local/certificates/
                  name: webhook-cert
                  readOnly: true
          dnsPolicy: ClusterFirst
          nodeSelector:
            kubernetes.io/os: linux
          serviceAccountName: ingress-nginx-neo
          terminationGracePeriodSeconds: 300
          volumes:
            - name: webhook-cert
              secret:
                secretName: ingress-nginx-neo-admission
  2: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: ingress-nginx-neo
        app.kubernetes.io/part-of: ingress-nginx-neo
        app.kubernetes.io/version: v1.2.3
        helm.sh/chart: ingress-nginx-neo-1.2.3
      name: ingress-nginx-neo-controller-metrics
      namespace: ingress-nginx-neo
    spec:
      ports:
        - name: metrics
          port: 10254
          protocol: TCP
          targetPort: metrics
      selector:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/name: ingress-nginx-neo
      type: ClusterIP
controller-daemonset-podannotations-values.yaml annotates the pods of a DaemonSet:
  1: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: ingress-nginx-neo
        app.kubernetes.io/part-of: ingress-nginx-neo
        app.kubernetes.io/version: v1.2.3
        helm.sh/chart: ingress-nginx-neo-1.2.3
      name: ingress-nginx-neo-controller
      namespace: ingress-nginx-neo
    spec:
      minReadySeconds: 0
      revisionHistoryLimit: 10
      selector:
        matchLabels:
          app.kubernetes.io/component: controller
          app.kubernetes.io/instance: ingress-nginx-neo
          app.kubernetes.io/name: ingress-nginx-neo
      template:
        metadata:
          annotations:
            prometheus.io/path: /metrics
            prometheus.io/port: "10254"
            prometheus.io/scheme: http
            prometheus.io/scrape: "true"
          labels:
            app.kubernetes.io/component: controller
            app.kubernetes.io/instance: ingress-nginx-neo
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: ingress-nginx-neo
            app.kubernetes.io/part-of: ingress-nginx-neo
            app.kubernetes.io/version: v1.2.3
            helm.sh/chart: ingress-nginx-neo-1.2.3
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - /nginx-ingress-controller
                - --publish-service=$(POD_NAMESPACE)/ingress-nginx-neo-controller
                - --election-id=ingress-nginx-neo-leader
                - --controller-class=k8s.io/ingress-nginx
                - --ingress-class=nginx
                - --configmap=$(POD_NAMESPACE)/ingress-nginx-neo-controller
                - --validating-webhook=:8443
                - --validating-webhook-certificate=/usr/local/certificates/cert
                - --validating-webhook-key=/usr/local/certificates/key
              env:
                - name: POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: LD_PRELOAD
                  value: /usr/local/lib/libmimalloc.so
              image: ghcr.io/kuzmenko-pavel/ingress-nginx-neo/controller:v1.2.3
              imagePullPolicy: IfNotPresent
              lifecycle:
                preStop:
                  exec:
                    command:
                      - /wait-shutdown
              livenessProbe:
                failureThreshold: 5
                httpGet:
                  path: /healthz
                  port: 10254
                  scheme: HTTP
                initialDelaySeconds: 10
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 1
              name: controller
              ports:
                - containerPort: 80
                  name: http
                  protocol: TCP
                - containerPort: 443
                  name: https
                  protocol: TCP
                - containerPort: 8443
                  name: webhook
                  protocol: TCP
              readinessProbe:
                failureThreshold: 3
                httpGet:
                  path: /healthz
                  port: 10254
                  scheme: HTTP
                initialDelaySeconds: 10
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 1
              resources:
                requests:
                  cpu: 100m
                  memory: 90Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  add:
                    - NET_BIND_SERVICE
                  drop:
                    - ALL
                readOnlyRootFilesystem: false
                runAsGroup: 82
                runAsNonRoot: true
                runAsUser: 101
                seccompProfile:
                  type: RuntimeDefault
              volumeMounts:
                - mountPath: /usr/local/certificates/
                  name: webhook-cert
                  readOnly: true
