controller-service-internal-values.yaml adds an internal Service:
  1: |
    apiVersion: v1
    kind: Service
    metadata:
      annotations:
        service.beta.kubernetes.io/aws-load-balancer-internal: "true"
      labels:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: ingress-nginx-neo
        app.kubernetes.io/part-of: ingress-nginx-neo
        app.kubernetes.io/version: v1.2.3
        external-dns.alpha.kubernetes.io/hostname: internal.example.com
        helm.sh/chart: ingress-nginx-neo-1.2.3
      name: ingress-nginx-neo-controller-internal
      namespace: ingress-nginx-neo
    spec:
      ipFamilies:
        - IPv4
      ipFamilyPolicy: SingleStack
      ports:
        - appProtocol: http
          name: http
          port: 80
          protocol: TCP
          targetPort: http
        - appProtocol: https
          name: https
          port: 443
          protocol: TCP
          targetPort: https
      selector:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/name: ingress-nginx-neo
      type: ClusterIP
controller-service-values.yaml exposes TCP and UDP services on node ports:
  1: |
    apiVersion: v1
    kind: Service
    metadata:
      annotations: null
      labels:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: ingress-nginx-neo
        app.kubernetes.io/part-of: ingress-nginx-neo
        app.kubernetes.io/version: v1.2.3
        external-dns.alpha.kubernetes.io/hostname: external.example.com
        helm.sh/chart: ingress-nginx-neo-1.2.3
      name: ingress-nginx-neo-controller
      namespace: ingress-nginx-neo
    spec:
      ipFamilies:
        - IPv4
      ipFamilyPolicy: SingleStack
      ports:
        - appProtocol: http
          name: http
          port: 80
          protocol: TCP
          targetPort: http
        - appProtocol: https
          name: https
          port: 443
          protocol: TCP
          targetPort: https
        - name: port-9000-tcp
          nodePort: 30090
          port: 9000
          protocol: TCP
          targetPort: port-9000-tcp
        - name: port-9001-udp
          nodePort: 30091
          port: 9001
          protocol: UDP
          targetPort: port-9001-udp
      selector:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/name: ingress-nginx-neo
      type: NodePort
  2: |
    apiVersion: v1
    data:
      "9000": default/test:8080
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: ingress-nginx-neo
        app.kubernetes.io/part-of: ingress-nginx-neo
        app.kubernetes.io/version: v1.2.3
        helm.sh/chart: ingress-nginx-neo-1.2.3
      name: ingress-nginx-neo-tcp
      namespace: ingress-nginx-neo
  3: |
    apiVersion: v1
    data:
      "9001": default/test:8080
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: ingress-nginx-neo
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: ingress-nginx-neo
        app.kubernetes.io/part-of: ingress-nginx-neo
        app.kubernetes.io/version: v1.2.3
        helm.sh/chart: ingress-nginx-neo-1.2.3
      name: ingress-nginx-neo-udp
      namespace: ingress-nginx-neo
